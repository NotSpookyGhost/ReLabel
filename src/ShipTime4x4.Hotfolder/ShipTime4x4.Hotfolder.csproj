<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ReLabel</AssemblyName>
    <Product>ReLabel</Product>
    <Version>2.5.0</Version>
    <FileVersion>2.5.0.0</FileVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\printer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShipTime4x4.Core\ShipTime4x4.Core.csproj" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8125" />
    <PackageReference Include="SkiaSharp" Version="4.154.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.155.0" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="tessdata\eng.traineddata" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\printer.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\settings.png" Link="Assets\settings.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ShipTime4x4.Tests" />
  </ItemGroup>
</Project>
